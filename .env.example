PORT=8080
WORKSPACE_ROOT=./workspace
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
ENABLE_EXEC_API=false
EXEC_TIMEOUT_MS=15000
EXEC_MAX_OUTPUT_BYTES=256000
FS_READ_MAX_BYTES=1048576

# Optional: override where AIOS stores provider settings outside git.
# If unset, AIOS uses ~/.config/aios
AIOS_CONFIG_DIR=

# Optional: local app-shell data directory (window state, imports, audit metadata).
# If unset, AIOS uses ./workspace/.aios-data
AIOS_DATA_DIR=

# Optional: GitHub Copilot settings.
# Recommended token sources (OpenClaw-style precedence):
# 1) COPILOT_GITHUB_TOKEN
# 2) GH_TOKEN
# 3) GITHUB_TOKEN
# If one is set, AIOS can use Copilot without device login.
GITHUB_COPILOT_BASE_URL=https://api.githubcopilot.com
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_TOKEN=

# Optional: AIOS has a bundled public client ID for github.com/login/device.
# Set this only if you want to use your own GitHub OAuth app.
GITHUB_COPILOT_CLIENT_ID=
GITHUB_COPILOT_OAUTH_SCOPE=read:user

# Optional fallback provider secrets/base URLs in .env.
# Prefer configuring providers from the AIOS UI instead.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# BAIDU_API_KEY=
# BAIDU_SECRET_KEY=
# BAIDU_BASE_URL=https://qianfan.baidubce.com/v2
